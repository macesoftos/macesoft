generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  status          String           @default("Active")
  branches        Branch[]
  accounts        Account[]
  invitations     UserInvitation[]
  payrollRuns     PayrollRun[]
  commissionRules CommissionRule[]
  subscription    Subscription?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Subscription {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planCode                  String?
  requestedPlanCode         String?
  billingCycle              String       @default("monthly")
  requestedBillingCycle     String?
  status                    String       @default("pending_plan")
  trialStartAt              DateTime?
  trialEndAt                DateTime?
  paidStartAt               DateTime?
  renewalAt                 DateTime?
  cancellationAt            DateTime?
  expiresAt                 DateTime?
  activationRequestedAt     DateTime?
  paymentProviderReference  String       @default("")
  includedWebsitePages      Int          @default(8)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([status, trialEndAt])
  @@index([planCode, status])
}

model Client {
  id                 String                    @id @default(cuid())
  fullName           String
  firstName          String                    @default("")
  middleName         String                    @default("")
  lastName           String                    @default("")
  photo              String                    @default("")
  mobile             String                    @default("")
  email              String                    @default("")
  gender             String                    @default("")
  birthday           String                    @default("")
  address            String                    @default("")
  street             String                    @default("")
  barangay           String                    @default("")
  city               String                    @default("")
  province           String                    @default("")
  civilStatus        String                    @default("")
  occupation         String                    @default("")
  emergency          String                    @default("")
  emergencyName      String                    @default("")
  emergencyPhone     String                    @default("")
  branch             String                    @default("")
  branchesVisited    String                    @default("[]")
  source             String                    @default("Walk-in")
  referral           String                    @default("")
  medicalNotes       String                    @default("")
  allergies          String                    @default("")
  contraindications  String                    @default("")
  skinConcerns       String                    @default("")
  treatmentGoals     String                    @default("")
  consentStatus      String                    @default("Pending")
  marketingOptIn     Boolean                   @default(true)
  preferredStaff     String                    @default("")
  tag                String                    @default("New")
  retention          String                    @default("New")
  lastVisit          String                    @default("")
  nextVisit          String                    @default("")
  balance            Float                     @default(0)
  packageBalance     String                    @default("None")
  giftBalance        Float                     @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  appointments       Appointment[]
  treatments         Treatment[]
  packages           ClinicPackage[]
  sales              Sale[]
  consentSubmissions ClientConsentSubmission[]

  @@index([fullName])
  @@index([mobile])
  @@index([branch])
}

model Branch {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                  String                 @unique
  code                  String
  city                  String                 @default("")
  address               String                 @default("")
  phone                 String                 @default("")
  email                 String                 @default("")
  timezone              String                 @default("Asia/Manila")
  hours                 String                 @default("")
  operatingHours        String                 @default("{}")
  status                String                 @default("Active")
  archivedAt            DateTime?
  staff                 Int                    @default(0)
  couches               Int                    @default(0)
  devices               String                 @default("[]")
  image                 String                 @default("")
  rooms                 Room[]
  memberships           BranchMembership[]
  modules               BranchModule[]
  auditLogs             AuditLog[]
  invitationAssignments UserInvitationBranch[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status    String   @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branchId])
}

model StaffMember {
  id                String                      @id @default(cuid())
  name              String
  photo             String                      @default("")
  role              String
  branch            String                      @default("")
  branches          String                      @default("[]")
  schedule          String                      @default("")
  scheduleBranches  String                      @default("[]")
  commissionType    String                      @default("")
  commissionRate    Float                       @default(0)
  services          String                      @default("")
  status            String                      @default("Available")
  attendance        String                      @default("Clocked out")
  employmentDate    String                      @default("")
  employmentStatus  String                      @default("Regular")
  birthDate         String                      @default("")
  address           String                      @default("")
  emergencyContact  String                      @default("")
  emergencyPhone    String                      @default("")
  phone             String                      @default("")
  account           Account?
  attendanceEvents  AttendanceEvent[]
  faceTrackProfile  FaceTrackProfile?
  faceTrackRecords  FaceTrackAttendanceRecord[]
  payrollProfile    PayrollEmployeeProfile?
  payrollSchedules  PayrollScheduleEntry[]
  payrollLines      PayrollLine[]
  payrollEarnings   PayrollCommissionEarning[]
  payrollDeductions PayrollSalaryDeduction[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([branch])
  @@index([role])
}

model Account {
  id                      String                       @id @default(cuid())
  staffId                 String?                      @unique
  staff                   StaffMember?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name                    String
  email                   String                       @unique
  passwordHash            String
  role                    String
  branch                  String                       @default("")
  organizationId          String
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationWideAccess  Boolean                      @default(false)
  organizationPermissions String                       @default("[]")
  organizationModules     String                       @default("[]")
  lastBranchId            String?
  status                  String                       @default("Active")
  mustChangePassword      Boolean                      @default(true)
  failedLoginCount        Int                          @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  notificationsReadAt     DateTime?
  sessions                AuthSession[]
  attendanceEvents        AttendanceEvent[]
  faceTrackEnrollments    FaceTrackProfile[]           @relation("FaceTrackEnrolledBy")
  faceTrackRequests       FaceTrackCorrectionRequest[] @relation("FaceTrackRequestedBy")
  faceTrackReviews        FaceTrackCorrectionRequest[] @relation("FaceTrackReviewedBy")
  faceTrackChallenges     FaceTrackChallenge[]
  sentInvitations         UserInvitation[]             @relation("InvitationSender")
  acceptedInvitations     UserInvitation[]             @relation("InvitationAcceptor")
  revokedInvitations      UserInvitation[]             @relation("InvitationRevoker")
  passwordResetTokens     PasswordResetToken[]
  flipbooks               Flipbook[]
  branchMemberships       BranchMembership[]
  branchAuditEntries      AuditLog[]                   @relation("AuditActor")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@index([role])
  @@index([branch])
  @@index([organizationId, status])
}

model BranchMembership {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role        String
  permissions String   @default("[]")
  modules     String   @default("[]")
  status      String   @default("Active")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, accountId])
  @@index([accountId, status])
  @@index([branchId, role, status])
}

model BranchModule {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  moduleId  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, moduleId])
  @@index([branchId, enabled])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, createdAt])
  @@index([expiresAt])
}

model UserInvitation {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  name            String
  firstName       String                 @default("")
  lastName        String                 @default("")
  role            String
  branch          String                 @default("")
  branches        UserInvitationBranch[]
  department      String                 @default("")
  specialty       String                 @default("")
  position        String                 @default("")
  modules         String                 @default("[]")
  permissions     String                 @default("[]")
  message         String                 @default("")
  status          String                 @default("Pending")
  deliveryStatus  String                 @default("Not Sent")
  tokenHash       String?                @unique
  expiresAt       DateTime
  resentAt        DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      Account?               @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       Account?               @relation("InvitationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  termsAcceptedAt DateTime?
  failedReason    String                 @default("")
  invitedById     String
  invitedBy       Account                @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId, email, status])
  @@index([invitedById, createdAt])
  @@index([expiresAt])
}

model UserInvitationBranch {
  id           String         @id @default(cuid())
  invitationId String
  invitation   UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@unique([invitationId, branchId])
  @@index([branchId, createdAt])
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model AttendanceEvent {
  id         String      @id @default(cuid())
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type       String
  branch     String      @default("")
  note       String      @default("")
  occurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@index([staffId, occurredAt])
  @@index([accountId, occurredAt])
}

model FaceTrackProfile {
  id                  String      @id @default(cuid())
  staffId             String      @unique
  staff               StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  encryptedDescriptor String
  descriptorVersion   String      @default("face-api-v1")
  consentAt           DateTime
  enrolledById        String?
  enrolledBy          Account?    @relation("FaceTrackEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)
  lastVerifiedAt      DateTime?
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([active])
}

model FaceTrackAttendanceRecord {
  id                        String                       @id @default(cuid())
  staffId                   String
  staff                     StaffMember                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDate                  String
  branch                    String                       @default("")
  timezone                  String                       @default("Asia/Manila")
  scheduledStart            DateTime
  scheduledEnd              DateTime
  originalTimeIn            DateTime?
  originalTimeOut           DateTime?
  timeIn                    DateTime?
  timeOut                   DateTime?
  workedMinutes             Int                          @default(0)
  lateMinutes               Int                          @default(0)
  calculatedOvertimeMinutes Int                          @default(0)
  approvedOvertimeMinutes   Int                          @default(0)
  overtimeStatus            String                       @default("NOT_APPLICABLE")
  status                    String                       @default("OPEN")
  verificationMethod        String                       @default("FACE_RECOGNITION")
  timeInConfidence          Float?
  timeOutConfidence         Float?
  correctionRequests        FaceTrackCorrectionRequest[]
  auditEntries              FaceTrackAuditEntry[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  @@unique([staffId, workDate])
  @@index([workDate])
  @@index([branch, workDate])
  @@index([status])
  @@index([overtimeStatus])
}

model FaceTrackCorrectionRequest {
  id                 String                    @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   FaceTrackAttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        Account                   @relation("FaceTrackRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById       String?
  reviewedBy         Account?                  @relation("FaceTrackReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  requestedTimeIn    DateTime?
  requestedTimeOut   DateTime?
  originalTimeIn     DateTime?
  originalTimeOut    DateTime?
  reason             String
  attachmentUrl      String                    @default("")
  status             String                    @default("PENDING")
  adminComment       String                    @default("")
  reviewedAt         DateTime?
  appliedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([attendanceRecordId])
  @@index([requestedById, status])
  @@index([status, createdAt])
}

model FaceTrackAuditEntry {
  id                  String                    @id @default(cuid())
  attendanceRecordId  String
  attendanceRecord    FaceTrackAttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  correctionRequestId String?
  actorAccountId      String
  actorName           String
  actorRole           String
  action              String
  originalValues      String                    @default("{}")
  requestedValues     String                    @default("{}")
  finalValues         String                    @default("{}")
  reason              String                    @default("")
  comment             String                    @default("")
  createdAt           DateTime                  @default(now())

  @@index([attendanceRecordId, createdAt])
  @@index([correctionRequestId])
}

model FaceTrackChallenge {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String
  nonceHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, purpose])
  @@index([expiresAt])
}

model FaceTrackPolicy {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(true)
  timezone                 String   @default("Asia/Manila")
  graceMinutes             Int      @default(5)
  matchThreshold           Float    @default(0.5)
  overtimeMinimumMinutes   Int      @default(30)
  overtimeRequiresApproval Boolean  @default(true)
  retentionDays            Int      @default(730)
  updatedBy                String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model FaceTrackKioskDevice {
  id            String                    @id @default(cuid())
  name          String
  branch        String
  tokenHash     String                    @unique
  pinHash       String
  active        Boolean                   @default(true)
  lastSeenAt    DateTime?
  createdById   String
  createdByName String
  challenges    FaceTrackKioskChallenge[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([branch, active])
  @@index([createdById])
}

model FaceTrackKioskChallenge {
  id        String               @id @default(cuid())
  deviceId  String
  device    FaceTrackKioskDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  purpose   String               @default("KIOSK_CLOCK")
  nonceHash String               @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([deviceId, purpose])
  @@index([expiresAt])
}

model Service {
  id                      String                     @id @default(cuid())
  name                    String
  category                String
  serviceType             String                     @default("Regular Service")
  duration                Int                        @default(60)
  price                   Float                      @default(0)
  priceModel              String                     @default("Fixed price")
  priceUnit               String                     @default("")
  packageSessions         Int                        @default(0)
  packagePrice            Float                      @default(0)
  serviceValue            Float                      @default(0)
  recommendedIntervalDays Int                        @default(0)
  commission              String                     @default("")
  consumables             String                     @default("[]")
  branches                String                     @default("[]")
  staff                   String                     @default("[]")
  room                    String                     @default("")
  active                  Boolean                    @default(true)
  pos                     Boolean                    @default(true)
  description             String                     @default("")
  contraindications       String                     @default("")
  aftercare               String                     @default("")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  appointments            Appointment[]
  commissionRules         CommissionRule[]
  payrollEarnings         PayrollCommissionEarning[]

  @@index([category])
  @@index([active])
}

model Appointment {
  id               String   @id @default(cuid())
  date             String
  time             String
  clientId         String?
  clientRecord     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  client           String
  serviceId        String?
  serviceRecord    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  service          String
  branch           String
  room             String   @default("")
  staff            String   @default("")
  duration         Int      @default(0)
  appointmentType  String   @default("Treatment")
  insurance        String   @default("")
  tags             String   @default("")
  packageName      String   @default("")
  timezone         String   @default("Asia/Manila")
  recurrence       String   @default("None")
  recurrenceUntil  String   @default("")
  status           String   @default("Pending")
  deposit          Float    @default(0)
  leadId           String   @default("")
  notes            String   @default("")
  internalNotes    String   @default("")
  publicBookingKey String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([branch])
  @@index([status])
  @@index([leadId])
}

model Treatment {
  id                 String           @id @default(cuid())
  clientId           String?
  clientRecord       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  client             String
  date               String
  service            String
  branch             String           @default("")
  provider           String           @default("")
  room               String           @default("")
  preNotes           String           @default("")
  postNotes          String           @default("")
  aftercare          String           @default("")
  arrivalTime        String           @default("")
  treatmentStartTime String           @default("")
  completedTime      String           @default("")
  checkoutTime       String           @default("")
  consumables        String           @default("")
  deviceSettings     String           @default("")
  batch              String           @default("")
  consent            String           @default("Pending")
  followUp           String           @default("")
  outcome            String           @default("")
  satisfaction       String           @default("")
  photos             Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  photoLinks         TreatmentPhoto[]

  @@index([clientId])
  @@index([branch])
  @@index([date])
}

model Promotion {
  id           String   @id @default(cuid())
  name         String
  serviceIds   String   @default("[]")
  packageNames String   @default("[]")
  discountType String   @default("Percentage")
  value        Float    @default(0)
  startDate    String
  endDate      String
  branches     String   @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([active])
}

model ConsentFormTemplate {
  id             String                    @id @default(cuid())
  name           String
  version        String
  serviceIds     String                    @default("[]")
  content        String                    @default("")
  requiredFields String                    @default("[]")
  active         Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  submissions    ClientConsentSubmission[]

  @@unique([name, version])
}

model ClientConsentSubmission {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  templateId  String
  template    ConsentFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  formName    String
  formVersion String
  service     String              @default("")
  treatmentId String              @default("")
  branch      String
  signature   String
  witness     String              @default("")
  answers     String              @default("{}")
  status      String              @default("Signed")
  signedAt    DateTime            @default(now())
  createdAt   DateTime            @default(now())

  @@index([clientId, signedAt])
  @@index([templateId])
  @@index([branch])
}

model TreatmentPhoto {
  id          String      @id @default(cuid())
  treatmentId String
  treatment   Treatment   @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  assetId     String      @unique
  asset       UploadAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind        String      @default("Clinical")
  createdAt   DateTime    @default(now())

  @@index([treatmentId, createdAt])
}

model InventoryItem {
  id        String   @id @default(cuid())
  item      String
  sku       String   @default("")
  brand     String   @default("")
  category  String   @default("")
  type      String   @default("Consumable")
  unit      String   @default("")
  packQty   Int      @default(1)
  beginning Float    @default(0)
  stock     Float    @default(0)
  branch    String   @default("")
  location  String   @default("")
  reorder   Float    @default(0)
  expiry    String   @default("")
  batch     String   @default("")
  supplier  String   @default("")
  cost      Float    @default(0)
  price     Float    @default(0)
  image     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([branch])
  @@index([category])
}

model InventoryMovement {
  id          String   @id @default(cuid())
  date        String
  itemId      String   @default("")
  item        String
  branch      String   @default("")
  qty         Float
  reason      String
  user        String   @default("System")
  supplier    String   @default("")
  receivedBy  String   @default("")
  checkNumber String   @default("")
  unit        String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([itemId])
  @@index([branch])
}

model Sale {
  id                String                     @id @default(cuid())
  invoice           String                     @unique
  date              String
  time              String
  clientId          String?
  clientRecord      Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  client            String
  branch            String
  staff             String
  subtotal          Float                      @default(0)
  discount          Float                      @default(0)
  total             Float                      @default(0)
  payments          String                     @default("[]")
  status            String                     @default("Paid")
  leadId            String                     @default("")
  appointmentId     String?                    @unique
  notes             String                     @default("")
  testMode          Boolean                    @default(false)
  enteredAt         DateTime                   @default(now())
  items             SaleItem[]
  payrollEarnings   PayrollCommissionEarning[]
  payrollDeductions PayrollSalaryDeduction[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([date])
  @@index([clientId])
  @@index([branch])
  @@index([status])
  @@index([leadId])
}

model SaleItem {
  id                      String                    @id @default(cuid())
  saleId                  String
  sale                    Sale                      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name                    String
  type                    String
  qty                     Float                     @default(1)
  price                   Float                     @default(0)
  originalPrice           Float                     @default(0)
  priceModel              String                    @default("Fixed price")
  priceUnit               String                    @default("")
  discount                Float                     @default(0)
  provider                String                    @default("N/A")
  serviceId               String                    @default("")
  aftercare               String                    @default("")
  recommendedIntervalDays Int                       @default(0)
  payrollEarning          PayrollCommissionEarning?
}

model PayrollEmployeeProfile {
  id                    String      @id @default(cuid())
  staffId               String      @unique
  staff                 StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payType               String      @default("Monthly")
  monthlySalary         Float       @default(0)
  dailyRate             Float       @default(0)
  hourlyRate            Float       @default(0)
  periodsPerMonth       Int         @default(2)
  standardWorkDays      Int         @default(26)
  standardMinutesPerDay Int         @default(480)
  overtimeMultiplier    Float       @default(1.25)
  workDays              String      @default("[1,2,3,4,5,6]")
  paidLeaveCredits      Float       @default(0)
  active                Boolean     @default(false)
  updatedBy             String      @default("")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([active])
}

model PayrollScheduleEntry {
  id               String      @id @default(cuid())
  staffId          String
  staff            StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDate         String
  branch           String      @default("")
  type             String      @default("Work Day")
  paid             Boolean     @default(false)
  scheduledMinutes Int         @default(480)
  status           String      @default("Approved")
  notes            String      @default("")
  createdById      String      @default("")
  createdBy        String      @default("")
  approvedById     String      @default("")
  approvedBy       String      @default("")
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([staffId, workDate])
  @@index([workDate, status])
  @@index([branch, workDate])
}

model PayrollRun {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cutoffStart     String
  cutoffEnd       String
  payDate         String
  branch          String        @default("All branches")
  status          String        @default("Draft")
  notes           String        @default("")
  totalGross      Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  createdById     String
  createdBy       String
  approvedById    String        @default("")
  approvedBy      String        @default("")
  approvedAt      DateTime?
  finalizedById   String        @default("")
  finalizedBy     String        @default("")
  finalizedAt     DateTime?
  lines           PayrollLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, cutoffStart, cutoffEnd, branch])
  @@index([organizationId, status, cutoffEnd])
  @@index([branch, cutoffStart, cutoffEnd])
}

model PayrollLine {
  id                  String                     @id @default(cuid())
  payrollRunId        String
  payrollRun          PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staffId             String
  staff               StaffMember                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffName           String
  role                String
  branch              String
  scheduledDays       Float                      @default(0)
  workedDays          Float                      @default(0)
  regularMinutes      Int                        @default(0)
  overtimeMinutes     Int                        @default(0)
  undertimeMinutes    Int                        @default(0)
  absenceDays         Float                      @default(0)
  paidLeaveDays       Float                      @default(0)
  dayOffDays          Float                      @default(0)
  basePay             Float                      @default(0)
  overtimePay         Float                      @default(0)
  incentives          Float                      @default(0)
  commissions         Float                      @default(0)
  salaryDeductions    Float                      @default(0)
  otherDeductions     Float                      @default(0)
  grossPay            Float                      @default(0)
  totalDeductions     Float                      @default(0)
  netPay              Float                      @default(0)
  calculationDetails  String                     @default("{}")
  adjustments         PayrollAdjustment[]
  commissionEarnings  PayrollCommissionEarning[]
  salaryDeductionRows PayrollSalaryDeduction[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([payrollRunId, staffId])
  @@index([staffId, payrollRunId])
}

model PayrollAdjustment {
  id            String      @id @default(cuid())
  payrollLineId String
  payrollLine   PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  type          String
  amount        Float
  reason        String
  createdById   String
  createdBy     String
  createdAt     DateTime    @default(now())

  @@index([payrollLineId, type])
}

model CommissionRule {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  role               String
  serviceId          String?
  service            Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch             String       @default("All branches")
  ruleType           String       @default("Percentage")
  value              Float        @default(0)
  discountedRuleType String       @default("")
  discountedValue    Float        @default(0)
  packageBasis       String       @default("Session Value")
  priority           Int          @default(0)
  active             Boolean      @default(true)
  effectiveFrom      String       @default("")
  effectiveTo        String       @default("")
  createdById        String       @default("")
  createdBy          String       @default("")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, role, serviceId, branch])
  @@index([organizationId, active, role])
  @@index([serviceId])
}

model PayrollCommissionEarning {
  id            String       @id @default(cuid())
  sourceKey     String       @unique
  payrollLineId String?
  payrollLine   PayrollLine? @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  staffId       String
  staff         StaffMember  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItemId    String       @unique
  saleItem      SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sourceDate    String
  branch        String
  serviceName   String
  ruleName      String
  baseAmount    Float        @default(0)
  amount        Float        @default(0)
  status        String       @default("Pending")
  details       String       @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([staffId, sourceDate, status])
  @@index([payrollLineId])
}

model PayrollSalaryDeduction {
  id            String       @id @default(cuid())
  sourceKey     String       @unique
  payrollLineId String?
  payrollLine   PayrollLine? @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  staffId       String
  staff         StaffMember  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleInvoice   String
  sourceDate    String
  branch        String
  amount        Float
  status        String       @default("Pending")
  details       String       @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([staffId, sourceDate, status])
  @@index([payrollLineId])
}

model ClinicPackage {
  id             String   @id @default(cuid())
  name           String
  clientId       String?
  clientRecord   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  client         String
  sessions       Int      @default(0)
  used           Int      @default(0)
  expires        String   @default("")
  branch         String   @default("All branches")
  transferable   Boolean  @default(false)
  status         String   @default("Active")
  price          Float    @default(0)
  amountPaid     Float    @default(0)
  nextPayment    String   @default("")
  purchaseDate   String   @default("")
  serviceValue   Float    @default(0)
  paymentHistory String   @default("[]")
  sessionHistory String   @default("[]")
  sourceSaleId   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([sourceSaleId])
}

model GiftCertificate {
  id             String   @id @default(cuid())
  code           String   @unique
  client         String
  type           String   @default("Monetary Value")
  serviceId      String   @default("")
  service        String   @default("")
  issueDate      String   @default("")
  branch         String   @default("All branches")
  balance        Float    @default(0)
  expires        String   @default("")
  status         String   @default("Active")
  redeemedDate   String   @default("")
  redeemedBranch String   @default("")
  transactionId  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([branch])
}

model PosCart {
  id                      String   @id @default(cuid())
  clientId                String   @default("")
  client                  String   @default("Walk-in")
  branch                  String
  staff                   String   @default("")
  items                   String   @default("[]")
  discountId              String   @default("")
  manualDiscountType      String   @default("")
  manualDiscountValue     Float    @default(0)
  manualDiscountScope     String   @default("Transaction")
  manualDiscountTargetKey String   @default("")
  saleDate                String   @default("")
  testMode                Boolean  @default(false)
  createdById             String   @default("")
  createdBy               String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([branch, updatedAt])
  @@index([clientId, branch])
  @@index([createdById])
}

model Lead {
  id                  String                 @id @default(cuid())
  name                String
  firstName           String                 @default("")
  middleName          String                 @default("")
  lastName            String                 @default("")
  preferredName       String                 @default("")
  mobile              String                 @default("")
  alternateMobile     String                 @default("")
  email               String                 @default("")
  socialProfileId     String                 @default("")
  channelContactId    String                 @default("")
  preferredChannel    String                 @default("Phone")
  source              String                 @default("")
  sourcePlatform      String                 @default("")
  campaign            String                 @default("")
  adSet               String                 @default("")
  adCreative          String                 @default("")
  landingPage         String                 @default("")
  referrerUrl         String                 @default("")
  utmSource           String                 @default("")
  utmMedium           String                 @default("")
  utmCampaign         String                 @default("")
  utmContent          String                 @default("")
  utmTerm             String                 @default("")
  clickId             String                 @default("")
  formId              String                 @default("")
  externalLeadId      String                 @default("")
  firstTouchSource    String                 @default("")
  latestTouchSource   String                 @default("")
  interest            String                 @default("")
  interestedTreatment String                 @default("")
  interestedPackage   String                 @default("")
  concern             String                 @default("")
  message             String                 @default("")
  preferredDate       String                 @default("")
  preferredTime       String                 @default("")
  budgetRange         String                 @default("")
  urgency             String                 @default("Normal")
  inquiryType         String                 @default("First-time")
  status              String                 @default("New Inquiry")
  priority            String                 @default("Normal")
  score               Int                    @default(0)
  scoreReasons        String                 @default("[]")
  owner               String                 @default("")
  assignedStaffId     String                 @default("")
  branch              String                 @default("")
  assignedBranch      String                 @default("")
  created             String                 @default("")
  nextStep            String                 @default("")
  nextAction          String                 @default("")
  nextFollowUpAt      String                 @default("")
  lastContactedAt     String                 @default("")
  firstRespondedAt    String                 @default("")
  followUpCount       Int                    @default(0)
  slaDueAt            String                 @default("")
  slaState            String                 @default("On time")
  outcome             String                 @default("")
  lossReason          String                 @default("")
  permissionToContact Boolean                @default(true)
  marketingConsent    Boolean                @default(false)
  privacyConsent      Boolean                @default(false)
  consentSource       String                 @default("")
  consentTimestamp    String                 @default("")
  consentVersion      String                 @default("")
  consentText         String                 @default("")
  linkedClientId      String                 @default("")
  linkedAppointmentId String                 @default("")
  convertedAt         String                 @default("")
  convertedBy         String                 @default("")
  duplicateOfLeadId   String                 @default("")
  duplicateConfidence Int                    @default(0)
  duplicateReasons    String                 @default("[]")
  archivedAt          String                 @default("")
  activities          LeadActivity[]
  followUps           LeadFollowUp[]
  touchpoints         LeadTouchpoint[]
  externalIdentities  ExternalLeadIdentity[]
  assignments         LeadAssignment[]
  conversions         LeadConversion[]
  webhookEvents       WebhookEvent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status])
  @@index([branch])
  @@index([owner])
  @@index([mobile])
  @@index([email])
  @@index([externalLeadId])
  @@index([campaign])
  @@index([nextFollowUpAt])
  @@index([created])
  @@index([linkedClientId])
}

model LeadActivity {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String
  title          String
  note           String   @default("")
  channel        String   @default("")
  actor          String   @default("System")
  actorRole      String   @default("System")
  previousStatus String   @default("")
  newStatus      String   @default("")
  metadata       String   @default("{}")
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([occurredAt])
}

model LeadFollowUp {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   @default("Phone call")
  dueAt       String
  assignedTo  String   @default("")
  channel     String   @default("Phone")
  purpose     String   @default("")
  notes       String   @default("")
  reminderAt  String   @default("")
  outcome     String   @default("")
  status      String   @default("Upcoming")
  completedAt String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
  @@index([assignedTo])
}

model LeadTouchpoint {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source      String
  platform    String   @default("")
  campaign    String   @default("")
  adSet       String   @default("")
  adCreative  String   @default("")
  landingPage String   @default("")
  referrerUrl String   @default("")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  utmContent  String   @default("")
  utmTerm     String   @default("")
  clickId     String   @default("")
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([source])
  @@index([campaign])
  @@index([occurredAt])
}

model ExternalLeadIdentity {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  provider       String
  externalLeadId String
  formId         String   @default("")
  pageId         String   @default("")
  contactRef     String   @default("")
  payloadRef     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, externalLeadId])
  @@index([leadId])
  @@index([provider])
}

model LeadIntegration {
  id                   String   @id @default(cuid())
  provider             String   @unique
  label                String
  status               String   @default("Needs Configuration")
  paused               Boolean  @default(false)
  lastEventAt          String   @default("")
  lastSuccessfulSyncAt String   @default("")
  lastError            String   @default("")
  mappingVersion       String   @default("v1")
  fieldMapping         String   @default("{}")
  defaultBranch        String   @default("")
  defaultOwner         String   @default("Front Desk")
  configSummary        String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  idempotencyKey  String   @unique
  externalLeadId  String   @default("")
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  receivedAt      DateTime @default(now())
  status          String   @default("Received")
  attempts        Int      @default(0)
  error           String   @default("")
  mappingVersion  String   @default("v1")
  payloadSummary  String   @default("{}")
  mappedFields    String   @default("{}")
  duplicateResult String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider])
  @@index([providerEventId])
  @@index([status])
  @@index([leadId])
}

model LeadConversion {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId          String
  appointmentId     String   @default("")
  convertedBy       String   @default("")
  convertedAt       DateTime @default(now())
  source            String   @default("")
  campaign          String   @default("")
  revenueAttributed Float    @default(0)
  notes             String   @default("")

  @@unique([leadId])
  @@index([clientId])
}

model LeadAssignment {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousOwner String   @default("")
  newOwner      String
  changedBy     String   @default("System")
  reason        String   @default("")
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([newOwner])
}

model SmsTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("")
  text      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingCampaign {
  id                String                    @id @default(cuid())
  name              String
  branch            String                    @default("All branches")
  segment           String
  channel           String
  templateId        String                    @default("")
  subject           String                    @default("")
  message           String                    @default("")
  html              String                    @default("")
  design            Json?
  sent              Int                       @default(0)
  booked            Int                       @default(0)
  credits           Int                       @default(0)
  status            String                    @default("Draft")
  scheduledAt       DateTime?
  managerApproval   Boolean                   @default(true)
  deliveryStatus    String                    @default("")
  scheduledById     String                    @default("")
  approvedById      String                    @default("")
  approvedAt        DateTime?
  sentAt            DateTime?
  lastDeliveryError String                    @default("")
  deletedAt         DateTime?
  surveyResponses   MarketingSurveyResponse[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([deletedAt])
  @@index([branch])
  @@index([deliveryStatus, scheduledAt])
}

model MarketingEmailTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  thumbnail   String   @default("")
  editorMode  String   @default("visual")
  html        String   @default("")
  design      Json
  branch      String   @default("All branches")
  createdById String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([branch, updatedAt])
}

model MarketingAudienceMember {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String
  audience  String
  branch    String
  source    String   @default("Manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, audience, branch])
  @@index([branch, audience])
  @@index([email])
}

model MarketingSurveyResponse {
  id         String            @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  blockId    String
  answer     String
  recipient  String            @default("")
  createdAt  DateTime          @default(now())

  @@index([campaignId, blockId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  date      String
  name      String
  category  String
  branch    String
  amount    Float    @default(0)
  method    String   @default("")
  approver  String   @default("")
  status    String   @default("For approval")
  notes     String   @default("")
  receipt   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([branch])
  @@index([status])
}

model Discount {
  id         String   @id @default(cuid())
  name       String
  type       String
  value      Float    @default(0)
  active     Boolean  @default(true)
  permission String   @default("")
  applicable String   @default("")
  expiry     String   @default("")
  usage      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  time           String
  actor          String
  role           String
  actorAccountId String?
  actorAccount   Account? @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  area           String
  action         String
  subjectType    String   @default("")
  subjectId      String   @default("")
  details        String
  beforeValues   String   @default("{}")
  afterValues    String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([area])
  @@index([actor])
  @@index([branchId, createdAt])
  @@index([actorAccountId, createdAt])
}

model AppNotification {
  id                  String   @id @default(cuid())
  module              String
  title               String
  message             String
  recordId            String   @default("")
  branches            String[] @default(["All branches"])
  recipientAccountIds String[] @default([])
  actor               String   @default("System")
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([module, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UploadAsset {
  id             String          @id
  objectPath     String          @unique
  category       String
  branch         String
  originalName   String          @default("")
  mimeType       String
  byteSize       Int
  uploadedById   String
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  treatmentPhoto TreatmentPhoto?
  flipbook       Flipbook?

  @@index([branch])
  @@index([category])
  @@index([category, branch, createdAt])
  @@index([category, branch, deletedAt, createdAt])
  @@index([uploadedById])
}

model Flipbook {
  id            String                @id @default(cuid())
  title         String
  description   String                @default("")
  pageCount     Int
  status        String                @default("Draft")
  branch        String                @default("All branches")
  assetId       String                @unique
  asset         UploadAsset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     Account               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  publicToken   String?               @unique
  publicEnabled Boolean               @default(false)
  passwordHash  String                @default("")
  allowDownload Boolean               @default(false)
  expiresAt     DateTime?
  publishedAt   DateTime?
  deletedAt     DateTime?
  views         FlipbookView[]
  accessGrants  FlipbookAccessGrant[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([branch, updatedAt])
  @@index([branch, deletedAt])
  @@index([status, publicEnabled])
  @@index([createdById])
}

model FlipbookView {
  id         String   @id @default(cuid())
  flipbookId String
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  viewerKey  String
  userAgent  String   @default("")
  viewedAt   DateTime @default(now())

  @@index([flipbookId, viewedAt])
  @@index([flipbookId, viewerKey])
}

model FlipbookAccessGrant {
  id         String   @id @default(cuid())
  flipbookId String
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([flipbookId, expiresAt])
  @@index([expiresAt])
}

model FlipbookWorkspaceSetting {
  id                    String   @id @default("workspace")
  logo                  String   @default("")
  businessName          String   @default("MACE")
  viewerBackground      String   @default("#f4f1ed")
  defaultAccess         String   @default("Anyone with the link")
