API_PORT=3001
# Comma-separated HTTPS origins allowed to call the API. The first origin is
# used in invitation and password-reset links, so put the canonical domain first.
APP_ORIGIN=https://zenshotech.com,https://www.zenshotech.com,https://lightcoral-crab-954053.hostingersite.com
# Use development locally. The production container sets NODE_ENV=production.
NODE_ENV=development
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA chain when the database certificate is not in the host trust store.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
API_RATE_LIMIT=1500
LOGIN_RATE_LIMIT=10
PUBLIC_WRITE_RATE_LIMIT=20
INVITATION_RATE_LIMIT=20
INVITATION_EXPIRY_DAYS=7
MAX_JSON_BODY=2mb
MAX_UPLOAD_BYTES=3145728

# Google Identity Services Web Client ID. Add every deployed app origin to the
# credential's Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=

# 32+ random characters used to encrypt FaceTrack biometric descriptors at rest.
# Required in production. Rotate only through a planned biometric re-enrollment.
FACETRACK_ENCRYPTION_KEY=

# Supabase Postgres. Use the session pooler for the running API and the direct
# connection for Prisma migrations. Never expose either value to Vite/client code.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Private Supabase Storage bucket. The service key is server-only and must never
# use a VITE_ prefix. Uploaded files are proxied through authenticated API routes.
REQUIRE_OBJECT_STORAGE=true
STORAGE_BASE_URL=https://PROJECT_REF.supabase.co
STORAGE_BUCKET=clinical-assets
STORAGE_SERVICE_KEY=

# Private client profile and treatment photos. Cloudinary credentials are
# server-only. Assets use the authenticated delivery type and remain behind the
# application's authorization checks; never add these values with a VITE_ prefix.
CLIENT_IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zenshotech/client-images

# Encrypted database backups. Store the directory on a separate durable volume.
BACKUP_DIRECTORY=/var/backups/macesoft
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# Generic lead intake. Generate long, independent random values for each secret.
LEADS_WEBHOOK_SECRET=
LEADS_API_KEY=
GOOGLE_ADS_WEBHOOK_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Facebook / Meta Lead Ads. The verify token is a random value you create and
# enter in both this file and the Meta App webhook configuration.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0

# Set to true to test the Marketing send flow without contacting Twilio or SMTP.
MARKETING_DRY_RUN=false
REQUIRE_MARKETING_PROVIDERS=true
MAX_MARKETING_SENDS=500
MARKETING_SCHEDULER_ENABLED=true
MARKETING_SCHEDULER_INTERVAL_MS=30000

# SMS delivery via Twilio. Use either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=63

# Optional email delivery via an authenticated SMTP account. Configure all four
# SMTP identity fields together to enable invitations, password-reset links,
# and subscription quotation notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MACE by Dr. Mace <no-reply@example.com>"
SUBSCRIPTION_SALES_EMAIL=sales@zenshotech.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
